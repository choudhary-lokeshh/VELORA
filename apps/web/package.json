{
  "name": "@velora/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "next build && node ../../scripts/prepare-next-standalone.mjs web",
    "dev": "next dev --hostname ${VELORA_BIND_HOST:-127.0.0.1} --port 3000",
    "lint": "eslint app src test middleware.ts next.config.ts vitest.config.ts",
    "start": "PORT=3000 HOSTNAME=${VELORA_BIND_HOST:-0.0.0.0} node .next/standalone/apps/web/server.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@velora/api-client": "workspace:*",
    "@velora/config": "workspace:*",
    "@velora/consumer-client": "workspace:*",
    "@velora/creator-client": "workspace:*",
    "@velora/design-tokens": "workspace:*",
    "@velora/validation": "workspace:*",
    "next": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:"
  },
  "devDependencies": {
    "@testing-library/dom": "catalog:",
    "@testing-library/react": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "jsdom": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
