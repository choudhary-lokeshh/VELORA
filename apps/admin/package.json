{
  "name": "@velora/admin",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "next build && node ../../scripts/prepare-next-standalone.mjs admin",
    "dev": "next dev --port 3002",
    "lint": "eslint app src test middleware.ts next.config.ts vitest.config.ts",
    "start": "PORT=3002 HOSTNAME=${VELORA_BIND_HOST:-0.0.0.0} node .next/standalone/apps/admin/server.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@velora/api-client": "workspace:*",
    "@velora/config": "workspace:*",
    "@velora/design-tokens": "workspace:*",
    "next": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:"
  },
  "devDependencies": {
    "@testing-library/dom": "catalog:",
    "@testing-library/react": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "jsdom": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
