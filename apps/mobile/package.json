{
  "name": "@velora/mobile",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "expo-router/entry",
  "expo": {
    "install": {
      "exclude": [
        "typescript"
      ]
    }
  },
  "scripts": {
    "build": "expo export --platform ios --platform android --output-dir dist",
    "dev": "EXPO_PUBLIC_APP_ENV=${EXPO_PUBLIC_APP_ENV:-local} expo start",
    "doctor": "expo-doctor",
    "lint": "eslint app src test",
    "start": "EXPO_PUBLIC_APP_ENV=${EXPO_PUBLIC_APP_ENV:-local} expo start",
    "test": "jest --runInBand",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@expo/metro-runtime": "catalog:",
    "@velora/api-client": "workspace:*",
    "@velora/config": "workspace:*",
    "@velora/consumer-client": "workspace:*",
    "@velora/design-tokens": "workspace:*",
    "expo": "catalog:",
    "expo-constants": "catalog:",
    "expo-linking": "catalog:",
    "expo-router": "catalog:",
    "expo-secure-store": "catalog:",
    "expo-status-bar": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-native": "catalog:",
    "react-native-safe-area-context": "catalog:",
    "react-native-screens": "catalog:",
    "react-native-worklets": "catalog:"
  },
  "devDependencies": {
    "@react-native/metro-config": "catalog:",
    "@testing-library/react-native": "catalog:",
    "@types/jest": "catalog:",
    "@types/react": "catalog:",
    "@types/react-test-renderer": "catalog:",
    "expo-doctor": "catalog:",
    "jest": "catalog:",
    "jest-expo": "catalog:",
    "react-test-renderer": "catalog:",
    "typescript": "catalog:"
  }
}
