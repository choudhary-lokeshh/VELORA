# Safe local development values only. Never place production credentials here.
APP_ENV=local
HOST=127.0.0.1
PORT=4000
LOG_LEVEL=info
DATABASE_URL=postgresql://velora:velora_local_only@127.0.0.1:5432/velora
EPHEMERAL_REDIS_URL=redis://127.0.0.1:6379/0
QUEUE_REDIS_URL=redis://127.0.0.1:6379/1
# AUTH adapters. Only development/test implementations exist; staging and
# production refuse them and fail to start, because no identity, signing,
# recovery-delivery, or phishing-resistant authenticator provider is approved.
AUTH_IDENTITY_PROVIDER=local
AUTH_ACCESS_TOKEN_SIGNER=local-development-ed25519
AUTH_RECOVERY_DELIVERY=local-test
AUTH_PRIVILEGED_AUTHENTICATOR_VERIFIER=unavailable
AUTH_TOKEN_ISSUER=https://auth.velora.invalid
# Optional base64 PKCS8 Ed25519 private key. Leave empty and the API generates
# an ephemeral development key pair that does not survive a restart. Never place
# real key material here; production key custody is an unresolved decision.
AUTH_ACCESS_TOKEN_SIGNING_KEY=
# Optional comma-separated base64 SPKI Ed25519 public keys retired from signing
# whose access tokens must still verify. This is how a signing key is rotated;
# removing a key here revokes every token it ever signed.
AUTH_ACCESS_TOKEN_VERIFICATION_KEYS=
# Exact browser origins allowed to authenticate each audience. Empty means that
# audience cannot start a browser session.
AUTH_BROWSER_ORIGINS_CONSUMER_WEB=http://127.0.0.1:3000
AUTH_BROWSER_ORIGINS_CREATOR_STUDIO=http://127.0.0.1:3001
AUTH_BROWSER_ORIGINS_PLATFORM_ADMIN=
# Identity Assurance remains provider-neutral and fail-closed. `local-test`
# values are network-free fixtures accepted only in local/test environments.
IDENTITY_VERIFICATION_PROVIDER=unavailable
IDENTITY_JURISDICTION_POLICY=unpublished
# Read by the Next.js surfaces at request time, never inlined into the build.
VELORA_APP_ENV=local
VELORA_API_BASE_URL=http://127.0.0.1:4000
EXPO_PUBLIC_APP_ENV=local
EXPO_PUBLIC_API_BASE_URL=http://127.0.0.1:4000
# Optional Compose host-port overrides when local services already use defaults.
VELORA_POSTGRES_PORT=5432
VELORA_REDIS_PORT=6379
