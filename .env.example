# Safe local development values only. Never place production credentials here.
#
# This file is the complete list of environment variables Velora's own code
# reads. `pnpm env:check` fails if it and `packages/config/src/server.ts` ever
# disagree, so a new configuration field cannot ship without appearing here.
#
# Every field is documented in `docs/engineering/07-configuration-environments.md`:
# owner, secret or public, which environment needs it, what a blank value means,
# and what production does without it. Copy this file to `.env` for local
# development; `.env` is ignored by Git and must never be committed.
#
# Staging and production do not read this file. They take values from the
# runtime secret manager per ADR-0014, and today they refuse to start at all:
# every AUTH adapter that exists is a development one.

# --- Runtime ---------------------------------------------------------------
# Which environment the process believes it is. Decides every fail-closed guard
# below. `staging` and `production` refuse to start until AUTH providers exist.
APP_ENV=local
AI_PROVIDER=local-test
AI_KILL_SWITCH=disabled
# Interface the API binds. Blank means 127.0.0.1 in local/test and 0.0.0.0 in a
# deployed environment, which is the only sensible pair, so leave it alone
# unless a container network needs something else.
HOST=127.0.0.1
PORT=4000
LOG_LEVEL=info

# --- Data stores -----------------------------------------------------------
# Secret in every deployed environment; the local password below is a fixture
# that matches `compose.yaml` and grants nothing anywhere else. Required: the
# API and the worker refuse to start without all three.
DATABASE_URL=postgresql://velora:velora_local_only@127.0.0.1:5432/velora
# Ephemeral Redis holds cache, rate-limit, and signalling state. Losing it loses
# no durable fact.
EPHEMERAL_REDIS_URL=redis://127.0.0.1:6379/0
# Queue Redis is durable BullMQ infrastructure. These two must stay logically
# separate even when local development points them at one instance, because
# flushing the ephemeral one must never discard queued work.
QUEUE_REDIS_URL=redis://127.0.0.1:6379/1

# --- AUTH ------------------------------------------------------------------
# AUTH adapters. Only development/test implementations exist; staging and
# production refuse them and fail to start, because no identity, signing,
# recovery-delivery, or phishing-resistant authenticator provider is approved.
AUTH_IDENTITY_PROVIDER=local
AUTH_ACCESS_TOKEN_SIGNER=local-development-ed25519
AUTH_RECOVERY_DELIVERY=local-test
AUTH_PRIVILEGED_AUTHENTICATOR_VERIFIER=local-test-privileged
AUTH_TOKEN_ISSUER=https://auth.velora.invalid
# Optional base64 PKCS8 Ed25519 private key. Leave empty and the API generates
# an ephemeral development key pair that does not survive a restart. Never place
# real key material here; production key custody is an unresolved decision.
AUTH_ACCESS_TOKEN_SIGNING_KEY=
# Optional comma-separated base64 SPKI Ed25519 public keys retired from signing
# whose access tokens must still verify. This is how a signing key is rotated;
# removing a key here revokes every token it ever signed.
AUTH_ACCESS_TOKEN_VERIFICATION_KEYS=
# Exact browser origins allowed to authenticate each audience. Empty means that
# audience cannot start a browser session.
AUTH_BROWSER_ORIGINS_CONSUMER_WEB=http://127.0.0.1:3000
AUTH_BROWSER_ORIGINS_CREATOR_STUDIO=http://127.0.0.1:3001
AUTH_BROWSER_ORIGINS_PLATFORM_ADMIN=http://127.0.0.1:3002

# --- Identity Assurance ----------------------------------------------------
# Identity Assurance remains provider-neutral and fail-closed. `local-test`
# values are network-free fixtures accepted only in local/test environments.
IDENTITY_VERIFICATION_PROVIDER=unavailable
IDENTITY_JURISDICTION_POLICY=unpublished

# --- Trust & Safety --------------------------------------------------------
# Each of these publishes policy, not a provider, and each refuses on its own.
# `local-test` publishes deterministic wording or arithmetic so the engine is
# exercisable in local development; a deployed environment rejects it, because
# a deadline or a consent form invented here would carry no authority.
SAFETY_TAKEDOWN_POLICY=unpublished
SAFETY_APPEAL_POLICY=unpublished
SAFETY_CONSENT_POLICY=unpublished
# Mature content has exactly one value, in every environment, deliberately.
# ADR-0022 rejects shipping the workflow behind a flag that could be flipped,
# so `disabled` is the only value the schema admits. Do not add another.
SAFETY_MATURE_CONTENT=disabled

# --- Messaging -------------------------------------------------------------
# Where messaging asks whether two people may still interact. `trust-and-safety`
# is the real block store and works in local development; deployed environments
# refuse it, because message retention duration and post-block history
# visibility are undecided, so they carry no message rather than the wrong one.
MESSAGING_SAFETY_ELIGIBILITY=unavailable

# --- Realtime / RTC --------------------------------------------------------
# Two independent gates; either alone stops a call. `composed` builds the real
# eligibility answer from DISCOVERY and TRUST & SAFETY, and `local-test` is an
# in-process transport that reaches no network and carries no media. Both are
# refused in staging and production: no RTC provider is eligible, and call
# retention, regional availability, and recording posture are undecided.
REALTIME_CALL_ELIGIBILITY=unavailable
REALTIME_RTC_PROVIDER=unavailable
# How call movements reach a connected client. `redis` fans out over ephemeral
# Redis so two API replicas reach the same person; it holds no state and decides
# nothing. `unavailable` carries nothing, which is complete rather than degraded
# because clients read authoritative state over HTTP either way. Permitted in
# every environment, unlike the two gates above.
REALTIME_SIGNAL_TRANSPORT=unavailable

# --- Notifications ---------------------------------------------------------
# No email, push, or SMS provider is approved. `unavailable` does not discard a
# notice; it reports that no attempt was made, leaving the notice owed in
# PostgreSQL and deliverable the day a provider is approved. `local-test`
# records deliveries in process memory and is refused in deployed environments.
NOTIFICATIONS_DELIVERY_CHANNEL=unavailable

# --- Media -----------------------------------------------------------------
# No object-storage, CDN, or scanning provider is approved, so both refuse and
# both are rejected in staging and production. `local-test` storage is
# filesystem-backed so the API and worker see the same objects; it scans nothing
# and moderates nothing, and nothing it accepts is evidence about real content.
# An unavailable scanner never reports `clean`: inspection treats a refusal as a
# quarantine, so an environment with no scanning position accepts no media.
MEDIA_STORAGE_PROVIDER=unavailable
MEDIA_MALWARE_SCANNER=unavailable
# Both are required when, and only when, MEDIA_STORAGE_PROVIDER is `local-test`;
# selecting that adapter without them is a startup failure rather than a
# fallback, because a generated key works on one process and fails across two.
# The signing key is secret even locally. Leave both empty while storage is
# unavailable.
MEDIA_LOCAL_STORAGE_DIRECTORY=
MEDIA_DELIVERY_SIGNING_KEY=

# --- Billing and payouts ---------------------------------------------------
# Every seam that could move money, refused. `local-test` adapters fabricate
# successful payments, priced offers, and paid instructions for local
# development; one of them reachable in a deployed environment would mean fake
# paid subscriptions and a creator balance nobody was ever charged for, so all
# of them are rejected in staging and production.
BILLING_COMMERCE_ELIGIBILITY=local-test
BILLING_COMMERCE_POLICY=local-test
BILLING_PAYMENT_PROVIDER=local-test
BILLING_TAX_AUTHORITY=local-test
CLUBS_BILLING_ENTITLEMENT=unavailable
PAYOUTS_PROVIDER=unavailable
PAYOUTS_POLICY=unpublished

# --- Next.js surfaces (Consumer Web, Creator Studio, Platform Admin) --------
# Read by the Next.js surfaces at request time, never inlined into the build.
# Deliberately not `NEXT_PUBLIC_`: that would bake one environment's endpoint
# into the artifact every environment is supposed to share. Both are non-secret.
# Blank in local development is fine — the surfaces fall back to the loopback
# API below. Blank in staging or production is a startup failure, and a
# localhost value there is refused outright.
VELORA_APP_ENV=local
VELORA_API_BASE_URL=http://127.0.0.1:4000
# Interface the built Next.js servers bind. Read only by the `start` scripts,
# never by application code. Blank means 0.0.0.0. Not needed for `pnpm dev`.
VELORA_BIND_HOST=

# --- Consumer Mobile -------------------------------------------------------
# `EXPO_PUBLIC_` values are embedded in the shipped app bundle and readable by
# anyone holding it. Only these two may ever carry that prefix; a secret with it
# is a published secret. Expo reads `apps/mobile/.env`, not this file, so
# `pnpm dev` supplies these defaults to the mobile dev server directly. A build
# with no explicit environment is treated as production, which refuses a
# loopback endpoint.
EXPO_PUBLIC_APP_ENV=local
EXPO_PUBLIC_API_BASE_URL=http://127.0.0.1:4000

# --- Local Docker infrastructure -------------------------------------------
# Optional Compose host-port overrides when local services already use defaults.
# Docker Compose reads them from this file directly. Change the service URLs
# above to match when you change one.
VELORA_POSTGRES_PORT=5432
VELORA_REDIS_PORT=6379
