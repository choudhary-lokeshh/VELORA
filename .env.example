# Safe local development values only. Never place production credentials here.
APP_ENV=local
HOST=127.0.0.1
PORT=4000
LOG_LEVEL=info
DATABASE_URL=postgresql://velora:velora_local_only@127.0.0.1:5432/velora
EPHEMERAL_REDIS_URL=redis://127.0.0.1:6379/0
QUEUE_REDIS_URL=redis://127.0.0.1:6379/1
NEXT_PUBLIC_APP_ENV=local
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:4000
EXPO_PUBLIC_APP_ENV=local
EXPO_PUBLIC_API_BASE_URL=http://127.0.0.1:4000
# Optional Compose host-port overrides when local services already use defaults.
VELORA_POSTGRES_PORT=5432
VELORA_REDIS_PORT=6379
