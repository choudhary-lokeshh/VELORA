{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    // End-to-end specs evaluate script inside the browser, so DOM types apply
    // to this project only. No server or package project includes them.
    "lib": ["ES2024", "DOM"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "noEmit": true,
    "types": ["node"]
  },
  "include": ["e2e/**/*.ts", "playwright.config.ts"]
}
