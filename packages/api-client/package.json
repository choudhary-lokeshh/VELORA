{
  "name": "@velora/api-client",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "node ../../scripts/clean-build-output.mjs dist && pnpm generate:check && tsc -p tsconfig.build.json",
    "generate": "tsx scripts/generate-client.ts",
    "generate:check": "tsx scripts/generate-client.ts --check",
    "lint": "eslint src scripts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "openapi-fetch": "catalog:"
  },
  "devDependencies": {
    "@velora/validation": "workspace:*",
    "openapi-typescript": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:"
  }
}
