{
  "name": "@velora/validation",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./money": {
      "types": "./dist/money.d.ts",
      "import": "./dist/money.js"
    }
  },
  "scripts": {
    "build": "node ../../scripts/clean-build-output.mjs dist && pnpm generate:check && tsc -p tsconfig.build.json",
    "generate": "tsx scripts/generate-openapi.ts",
    "generate:check": "tsx scripts/generate-openapi.ts --check",
    "lint": "eslint src scripts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "zod": "catalog:"
  },
  "devDependencies": {
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
